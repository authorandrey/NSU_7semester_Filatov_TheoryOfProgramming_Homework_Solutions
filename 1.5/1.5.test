test_2      : #2#              -> #66#
test_3      : #3#              -> #76#
test_4      : #4#              -> #86#
test_5      : #5#              -> #96#
test_6      : #6#              -> #07#
test_7      : #7#              -> #17#
test_8      : #8#              -> #27#
test_9      : #9#              -> #37#
test_10     : #01#             -> #47#
test_11     : #11#             -> #57#
test_99     : #99#             -> #361#
test_100    : #001#            -> #461#
test_999    : #999#            -> #3601#
test_1000   : #0001#           -> #4601#
test_9999   : #9999#           -> #36001#
test_12345  : #54321#          -> #90421#
test_99999  : #99999#          -> #360001#