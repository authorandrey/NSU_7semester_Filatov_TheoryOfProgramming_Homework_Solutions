    4, 0, # -> 4R, 0R, 4R CARRY_0
    4, 1, # -> 4R, 1R, 0R CARRY_1
    4, 2, # -> 4R, 2R, 1R CARRY_1
    4, 3, # -> 4R, 3R, 2R CARRY_1
    4, 4, # -> 4R, 4R, 3R CARRY_1
    4, #, # -> 4R, #H, 4R CARRY_0
