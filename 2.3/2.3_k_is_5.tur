// Generated from 2.3_template.txt
// Add two base-5 numbers; least-significant digit first.
// Tape 1 and tape 2 are preserved; tape 3 stores the sum.
alphabet = [#, 0, 1, 2, 3, 4]
tapes = [ right, right, right ]

START:
    #, #, # -> #R, #R, #R INIT

