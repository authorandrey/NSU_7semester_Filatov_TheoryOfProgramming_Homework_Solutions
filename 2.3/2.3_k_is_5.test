// Base 5; inputs and output use least-significant digit first.
empty_plus_empty    : #|#|# -> #|#|#0#
zero_plus_zero      : #0#|#0#|# -> #0#|#0#|#0#
zero_plus_one       : #0#|#1#|# -> #0#|#1#|#1#
one_plus_one        : #1#|#1#|# -> #1#|#1#|#2#
carry_at_last_digit : #4#|#1#|# -> #4#|#1#|#01#
two_digit_sum       : #11#|#21#|# -> #11#|#21#|#32#
different_lengths   : #1#|#111#|# -> #1#|#111#|#211#
long_carry_chain    : #4444#|#1#|# -> #4444#|#1#|#00001#
same_number         : #2101#|#2101#|# -> #2101#|#2101#|#4202#
large_sum           : #400201#|#20301#|# -> #400201#|#20301#|#113211#
digit_0_0           : #0#|#0#|# -> #0#|#0#|#0#
digit_0_1           : #0#|#1#|# -> #0#|#1#|#1#
digit_0_2           : #0#|#2#|# -> #0#|#2#|#2#
digit_0_3           : #0#|#3#|# -> #0#|#3#|#3#
digit_0_4           : #0#|#4#|# -> #0#|#4#|#4#
digit_1_0           : #1#|#0#|# -> #1#|#0#|#1#
digit_1_1           : #1#|#1#|# -> #1#|#1#|#2#
digit_1_2           : #1#|#2#|# -> #1#|#2#|#3#
digit_1_3           : #1#|#3#|# -> #1#|#3#|#4#
digit_1_4           : #1#|#4#|# -> #1#|#4#|#01#
digit_2_0           : #2#|#0#|# -> #2#|#0#|#2#
digit_2_1           : #2#|#1#|# -> #2#|#1#|#3#
digit_2_2           : #2#|#2#|# -> #2#|#2#|#4#
digit_2_3           : #2#|#3#|# -> #2#|#3#|#01#
digit_2_4           : #2#|#4#|# -> #2#|#4#|#11#
digit_3_0           : #3#|#0#|# -> #3#|#0#|#3#
digit_3_1           : #3#|#1#|# -> #3#|#1#|#4#
digit_3_2           : #3#|#2#|# -> #3#|#2#|#01#
digit_3_3           : #3#|#3#|# -> #3#|#3#|#11#
digit_3_4           : #3#|#4#|# -> #3#|#4#|#21#
digit_4_0           : #4#|#0#|# -> #4#|#0#|#4#
digit_4_1           : #4#|#1#|# -> #4#|#1#|#01#
digit_4_2           : #4#|#2#|# -> #4#|#2#|#11#
digit_4_3           : #4#|#3#|# -> #4#|#3#|#21#
digit_4_4           : #4#|#4#|# -> #4#|#4#|#31#
