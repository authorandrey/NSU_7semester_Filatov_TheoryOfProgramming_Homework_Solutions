// tests addition of 3 to inversed binary number

test_empty : #                -> #
test_zero  : #0#              -> #11#
test_1     : #1#              -> #001#
test_2     : #01#             -> #101#
test_3     : #11#             -> #011#
test_4     : #001#            -> #111#
test_5     : #101#            -> #0001#
test_6     : #011#            -> #1001#
test_7     : #111#            -> #0101#
test_8     : #0001#           -> #1101#
test_9     : #1001#           -> #0011#
test_10    : #0101#           -> #1011#
test_11    : #1101#           -> #0111#
test_12    : #0011#           -> #1111#
test_13    : #1011#           -> #00001#
test_14    : #0111#           -> #10001#
test_15    : #1111#           -> #01001#
test_127   : #1111111#        -> #01000001#
test_567   : #1110110001#     -> #0101110001#
test_1023  : #1111111111#     -> #01000000001#