// tests reversing binary string

test_empty       : #                -> #
test_zero        : #0#              -> #0#
test_one         : #1#              -> #1#
test_01          : #01#             -> #10#
test_10          : #10#             -> #01#
test_11          : #11#             -> #11#
test_000         : #000#            -> #000#
test_001         : #001#            -> #100#
test_100         : #100#            -> #001#
test_101         : #101#            -> #101#
test_110         : #110#            -> #011#
test_011         : #011#            -> #110#
test_11001       : #11001#          -> #10011#
test_10011       : #10011#          -> #11001#
test_1110110001  : #1110110001#     -> #1000110111#
test_1111111111  : #1111111111#     -> #1111111111#
test_1010101010  : #1010101010#     -> #0101010101#
test_0000000000  : #0000000000#     -> #0000000000#
test_1000000001  : #1000000001#     -> #1000000001#
test_111000111   : #111000111#      -> #111000111#